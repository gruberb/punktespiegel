{
  "name": "@punktespiegel/frontend",
  "version": "1.31.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" && npm run check:architecture && npm run test:interactions",
    "check:architecture": "node --test testing/architecture.test.mjs",
    "test:interactions": "node --import ./testing/register-ts.mjs --test testing/interactions.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gruberb/fun-ui": "git+https://github.com/gruberb/fun-ui.git#05281f2f8fea8dfc9b8b1cbafb6899994e6192c5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "latest",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
