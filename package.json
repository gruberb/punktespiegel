{
  "name": "punktespiegel-dashboard",
  "version": "1.23.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:role-signals": "python3 scripts/fetch-current-role-signals.py",
    "generate:club-profiles": "python3 scripts/fetch-club-profiles.py",
    "generate:club-profiles:backfill": "python3 scripts/fetch-club-profiles.py --all-seasons",
    "test:club-profiles": "python3 -m unittest scripts/fetch_club_profiles_test.py",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend"
  }
}
