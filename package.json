{
  "name": "punktespiegel-fantasy-dashboard",
  "version": "1.16.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:recommendations:v2": "uv run --frozen python -m recommender",
    "generate:recommendations:interactive": "npm run generate:recommendations:v2",
    "generate:role-signals": "uv run --frozen python scripts/fetch-current-role-signals.py",
    "generate:recommendations": "npm run generate:role-signals && npm run generate:recommendations:v2",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend"
  }
}
